<%--@elvariable id="message" type="com.mau.app.model.Message"--%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>${title}</title>
</head>
<body>
<h1>${title}</h1>
<h2>User: ${loggedInUser.name}</h2>
<div class="actions">
    <form:form method="post" modelAttribute="message">

        <form:label path="msgContent">Message Content:</form:label><br/>
        <form:input path="msgContent"/><br/>
        <br/>
        <input type="submit" value="Save"/>
    </form:form>
</div>
</body>
</html>
